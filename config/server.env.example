# Shell environment for a NEW installation. Refuse startup with missing secrets.
KROMAREC_DOMAIN=rec.test
KROMAREC_BIND=127.0.0.1:8080
KROMAREC_PHOTON_GATE_ADDR=127.0.0.1:8081
# With an explicit database path, the signing secret is required at startup.
KROMAREC_DB=/var/lib/kromarec/kromarec.sqlite3
KROMAREC_ASSETS=/usr/local/share/kromarec/assets
KROMAREC_PASSWORD_SIGNUP=false
KROMAREC_PHOTON_REGION=us
KROMAREC_PHOTON_REALTIME_APP_ID=7a6eafd9-8a49-47bd-98da-c743525a3e72
KROMAREC_JWT_SECRET=${KROMAREC_JWT_SECRET:?configure a private signing secret}
KROMAREC_PHOTON_GATE_KEY=${KROMAREC_PHOTON_GATE_KEY:?configure a private 64-hex-character gate key}
