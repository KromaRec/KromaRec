+GameServerHandler::~GameServerHandler() {
+    if (admission_fd_ >= 0) close(admission_fd_);
+}
+
+void GameServerHandler::HandleSlowUpdate() {
+    HandlerBase::HandleSlowUpdate();
+    if (admission_fd_ < 0) return;
+    const auto now = std::chrono::steady_clock::now();
+    if (now - admission_checked_ < std::chrono::seconds(12)) {
+        char heartbeat{};
+        const auto count = recv(admission_fd_, &heartbeat, 1, MSG_DONTWAIT);
+        if (count == 1 && heartbeat == '+') {
+            admission_checked_ = now;
+            return;
+        }
+        if (count < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) return;
+    }
+    close(admission_fd_);
+    admission_fd_ = -1;
+    peer_->disconnect();
+}
