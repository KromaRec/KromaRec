export KROMAREC_BIND='127.0.0.1:8080'
export KROMAREC_DOMAIN='rec.example.net'
export KROMAREC_ASSETS='/usr/local/share/kromarec/assets'
export KROMAREC_DB='/var/lib/kromarec/kromarec.sqlite3'
export KROMAREC_MAX_CONNECTIONS='128'
export KROMAREC_PASSWORD_SIGNUP='false'
# This configuration selects persistent storage. Export the existing private
# KROMAREC_JWT_SECRET (minimum 32 bytes) here or source a private environment
# with set -a before enabling the service. Keep this file mode 0600.

# Match the app IDs configured in both 20230414 clients.
# export KROMAREC_PHOTON_REALTIME_APP_ID=''
# export KROMAREC_PHOTON_VOICE_APP_ID=''
# export KROMAREC_PHOTON_CHAT_APP_ID=''
# export KROMAREC_PHOTON_REGION='us'

# Required for multiplayer. Deploy the Luxon Game lease extension from 0.10.1.
# export KROMAREC_PHOTON_GATE_ADDR='127.0.0.1:8081'
# export KROMAREC_PHOTON_GATE_KEY='paste output of openssl rand -hex 32'

# Optional fixed-label HTTP, Photon and scene diagnostics.
# export KROMAREC_TRACE_STARTUP='true'
